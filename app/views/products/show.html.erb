<% content_for :title, "#{@product.name} — Kalz" %>

<div class="max-w-3xl space-y-5">
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-3">
      <%= link_to products_path, class: "text-gray-400 hover:text-gray-600" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      <% end %>
      <h1 class="text-2xl font-bold text-gray-900"><%= @product.name %></h1>
    </div>
    <%= link_to "Editar", edit_product_path(@product), class: "inline-flex items-center gap-2 border border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-medium px-4 py-2 rounded-lg" %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <%# Imagen grande %>
    <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
      <% if @product.photo.attached? %>
        <img id="product-img" src="<%= url_for(@product.photo) %>"
          class="w-full h-72 object-cover cursor-zoom-in"
          onclick="document.getElementById('img-modal').classList.remove('hidden')"
          alt="<%= @product.name %>">
      <% else %>
        <div class="w-full h-72 bg-gray-100 flex items-center justify-center">
          <svg class="w-16 h-16 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        </div>
      <% end %>
      <% if @product.photo.attached? %>
        <p class="text-xs text-center text-gray-400 py-2">Clic para ver en grande</p>
      <% end %>
    </div>

    <%# Datos del producto %>
    <div class="space-y-4">
      <div class="bg-white rounded-xl border border-gray-200 p-5 space-y-4">
        <div class="flex justify-between items-center">
          <span class="text-sm text-gray-500">Precio de compra</span>
          <span class="font-semibold text-gray-900">$<%= number_with_delimiter(@product.purchase_price) %></span>
        </div>
        <div class="flex justify-between items-center">
          <span class="text-sm text-gray-500">Precio de venta</span>
          <span class="font-semibold text-gray-900">$<%= number_with_delimiter(@product.sale_price) %></span>
        </div>
        <div class="flex justify-between items-center border-t border-gray-100 pt-3">
          <span class="text-sm text-gray-500">Ganancia por unidad</span>
          <span class="font-semibold text-green-600">$<%= number_with_delimiter(@product.profit_per_unit.round(2)) %></span>
        </div>
        <div class="flex justify-between items-center">
          <span class="text-sm text-gray-500">Margen</span>
          <span class="font-bold text-green-600"><%= @product.margin %>%</span>
        </div>
      </div>

      <div class="bg-white rounded-xl border border-gray-200 p-5">
        <div class="flex justify-between items-center mb-3">
          <span class="text-sm text-gray-500">Stock actual</span>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-sm font-medium
            <%= @product.out_of_stock? ? 'bg-red-100 text-red-700' : @product.low_stock? ? 'bg-yellow-100 text-yellow-700' : 'bg-green-100 text-green-700' %>">
            <%= @product.stock %> unidades
          </span>
        </div>
        <div class="flex justify-between items-center">
          <span class="text-sm text-gray-500">Alerta mínima</span>
          <span class="text-sm text-gray-700"><%= @product.min_stock %> uds.</span>
        </div>
        <% if @product.description.present? %>
          <div class="mt-3 pt-3 border-t border-gray-100">
            <p class="text-sm text-gray-500 mb-1">Descripción</p>
            <p class="text-sm text-gray-700"><%= @product.description %></p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<%# Modal imagen grande %>
<% if @product.photo.attached? %>
  <div id="img-modal" class="hidden fixed inset-0 bg-black bg-opacity-80 flex items-center justify-center z-50 p-4" onclick="this.classList.add('hidden')">
    <div class="relative max-w-4xl max-h-full">
      <img src="<%= url_for(@product.photo) %>" class="max-w-full max-h-screen object-contain rounded-lg" alt="<%= @product.name %>">
      <button onclick="document.getElementById('img-modal').classList.add('hidden')" class="absolute top-2 right-2 bg-white bg-opacity-80 hover:bg-opacity-100 text-gray-800 rounded-full w-8 h-8 flex items-center justify-center text-lg font-bold">×</button>
    </div>
  </div>
<% end %>
