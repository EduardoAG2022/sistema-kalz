<%= form_with model: customer, class: "space-y-5" do |f| %>
  <% if customer.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4 text-sm text-red-700">
      <ul class="list-disc pl-4 space-y-1">
        <% customer.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, "Nombre completo", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :name, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500", placeholder: "Juan Pérez" %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :email, "Email", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.email_field :email, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500", placeholder: "juan@email.com" %>
    </div>
    <div>
      <%= f.label :phone, "Teléfono", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :phone, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500", placeholder: "+1 555 0000" %>
    </div>
  </div>

  <div>
    <%= f.label :address, "Dirección", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_area :address, rows: 2, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500", placeholder: "Calle, ciudad, estado..." %>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= f.submit customer.new_record? ? "Crear cliente" : "Guardar cambios", class: "bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-5 py-2 rounded-lg cursor-pointer" %>
    <%= link_to "Cancelar", customers_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  </div>
<% end %>
