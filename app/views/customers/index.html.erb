<% content_for :title, "Clientes — Kalz" %>

<div class="space-y-5">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-900">Clientes</h1>
    <%= link_to new_customer_path, class: "inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-4 py-2 rounded-lg" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      Nuevo cliente
    <% end %>
  </div>

  <%= form_with url: customers_path, method: :get, class: "flex gap-3" do |f| %>
    <div class="relative flex-1 max-w-sm">
      <svg class="absolute left-3 top-2.5 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0"/></svg>
      <%= f.text_field :search, value: params[:search], placeholder: "Buscar por nombre o email...", class: "w-full pl-9 pr-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
    </div>
    <%= f.submit "Buscar", class: "px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium rounded-lg cursor-pointer" %>
  <% end %>

  <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
    <table class="w-full text-sm">
      <thead>
        <tr class="bg-gray-50 border-b border-gray-200">
          <th class="text-left px-4 py-3 font-medium text-gray-600">Cliente</th>
          <th class="text-left px-4 py-3 font-medium text-gray-600">Teléfono</th>
          <th class="text-right px-4 py-3 font-medium text-gray-600">Pedidos</th>
          <th class="text-right px-4 py-3 font-medium text-gray-600">Total gastado</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-50">
        <% @customers.each do |customer| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3">
              <p class="font-medium text-gray-900"><%= customer.name %></p>
              <p class="text-xs text-gray-400"><%= customer.email %></p>
            </td>
            <td class="px-4 py-3 text-gray-600"><%= customer.phone || "—" %></td>
            <td class="px-4 py-3 text-right text-gray-700"><%= customer.orders_count %></td>
            <td class="px-4 py-3 text-right font-medium text-gray-900">$<%= number_with_delimiter(customer.total_spent.to_f.round(2)) %></td>
            <td class="px-4 py-3">
              <div class="flex items-center justify-end gap-2">
                <%= link_to customer_path(customer), class: "p-1.5 text-gray-400 hover:text-indigo-600 rounded" do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                <% end %>
                <%= link_to edit_customer_path(customer), class: "p-1.5 text-gray-400 hover:text-indigo-600 rounded" do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                <% end %>
                <%= button_to customer_path(customer), method: :delete, data: { turbo_confirm: "¿Eliminar a #{customer.name}?" }, class: "p-1.5 text-gray-400 hover:text-red-600 rounded" do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
        <% if @customers.empty? %>
          <tr><td colspan="5" class="px-4 py-10 text-center text-gray-400">No hay clientes. <%= link_to "Agrega el primero", new_customer_path, class: "text-indigo-600 hover:underline" %>.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
</div>
