<% content_for :title, @supplier.name %>

<div class="mb-6">
  <div class="flex items-center gap-2 text-sm text-gray-500 mb-1">
    <%= link_to "Proveedores", suppliers_path, class: "hover:text-indigo-600" %>
    <span>/</span>
    <span><%= @supplier.name %></span>
  </div>
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-900"><%= @supplier.name %></h1>
    <div class="flex items-center gap-2">
      <%= link_to edit_supplier_path(@supplier), class: "inline-flex items-center gap-2 border border-gray-300 text-gray-700 hover:bg-gray-50 text-sm font-medium px-3 py-2 rounded-lg" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
        Editar
      <% end %>
    </div>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <%# Info card %>
  <div class="bg-white rounded-xl border border-gray-200 p-5 space-y-4">
    <h2 class="text-sm font-semibold text-gray-700 uppercase tracking-wide">Información</h2>
    <% if @supplier.contact_name.present? %>
      <div>
        <p class="text-xs text-gray-500 mb-0.5">Contacto</p>
        <p class="text-sm text-gray-900"><%= @supplier.contact_name %></p>
      </div>
    <% end %>
    <% if @supplier.email.present? %>
      <div>
        <p class="text-xs text-gray-500 mb-0.5">Email</p>
        <p class="text-sm text-gray-900"><%= @supplier.email %></p>
      </div>
    <% end %>
    <% if @supplier.phone.present? %>
      <div>
        <p class="text-xs text-gray-500 mb-0.5">Teléfono</p>
        <p class="text-sm text-gray-900"><%= @supplier.phone %></p>
      </div>
    <% end %>
    <% if @supplier.notes.present? %>
      <div>
        <p class="text-xs text-gray-500 mb-0.5">Notas</p>
        <p class="text-sm text-gray-600"><%= @supplier.notes %></p>
      </div>
    <% end %>
    <% if @supplier.contact_name.blank? && @supplier.email.blank? && @supplier.phone.blank? && @supplier.notes.blank? %>
      <p class="text-sm text-gray-400 italic">Sin información adicional</p>
    <% end %>
  </div>

  <%# Purchases list %>
  <div class="lg:col-span-2">
    <div class="flex items-center justify-between mb-3">
      <h2 class="text-sm font-semibold text-gray-700 uppercase tracking-wide">Órdenes de compra (<%= @purchases.count %>)</h2>
      <%= link_to new_purchase_path, class: "text-xs text-indigo-600 hover:underline font-medium" do %>
        + Nueva orden
      <% end %>
    </div>

    <% if @purchases.empty? %>
      <div class="bg-white rounded-xl border border-gray-200 p-8 text-center text-gray-400">
        <svg class="w-8 h-8 mx-auto mb-2 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
        <p class="text-sm">No hay órdenes con este proveedor</p>
      </div>
    <% else %>
      <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
        <table class="w-full text-sm">
          <thead class="bg-gray-50 border-b border-gray-200">
            <tr>
              <th class="text-left px-4 py-3 font-medium text-gray-600">Orden</th>
              <th class="text-left px-4 py-3 font-medium text-gray-600">Fecha</th>
              <th class="text-left px-4 py-3 font-medium text-gray-600">Estado</th>
              <th class="text-right px-4 py-3 font-medium text-gray-600">Productos</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @purchases.each do |purchase| %>
              <tr class="hover:bg-gray-50">
                <td class="px-4 py-3">
                  <%= link_to purchase.name, purchase_path(purchase), class: "font-medium text-indigo-700 hover:underline" %>
                </td>
                <td class="px-4 py-3 text-gray-500"><%= purchase.purchased_at&.strftime("%d/%m/%Y") %></td>
                <td class="px-4 py-3">
                  <% badge_class = case purchase.status
                    when "ordered" then "bg-yellow-50 text-yellow-700 ring-1 ring-yellow-300"
                    when "in_transit" then "bg-blue-50 text-blue-700 ring-1 ring-blue-300"
                    when "in_stock" then "bg-green-50 text-green-700 ring-1 ring-green-300"
                    end %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium <%= badge_class %>">
                    <%= { "ordered" => "Pedido", "in_transit" => "En camino", "in_stock" => "En stock" }[purchase.status] %>
                  </span>
                </td>
                <td class="px-4 py-3 text-right text-gray-600"><%= purchase.purchase_items.count %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</div>
