<% content_for :title, "Editar proveedor" %>

<div class="max-w-2xl mx-auto">
  <div class="mb-6">
    <div class="flex items-center gap-2 text-sm text-gray-500 mb-1">
      <%= link_to "Proveedores", suppliers_path, class: "hover:text-indigo-600" %>
      <span>/</span>
      <%= link_to @supplier.name, supplier_path(@supplier), class: "hover:text-indigo-600" %>
      <span>/</span>
      <span>Editar</span>
    </div>
    <h1 class="text-2xl font-bold text-gray-900">Editar proveedor</h1>
  </div>

  <div class="bg-white rounded-xl border border-gray-200 p-6">
    <%= render "form", supplier: @supplier %>
  </div>
</div>
