<% content_for :title, "Pedidos — Kalz" %>

<div class="space-y-5">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-900">Pedidos</h1>
    <%= link_to new_order_path, class: "inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-4 py-2 rounded-lg" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      Nuevo pedido
    <% end %>
  </div>

  <div class="flex gap-2">
    <%= link_to "Todos", orders_path, class: "px-3 py-1.5 rounded-lg text-sm font-medium #{params[:status].blank? ? 'bg-indigo-600 text-white' : 'bg-white border border-gray-300 text-gray-600 hover:bg-gray-50'}" %>
    <%= link_to "Pendiente", orders_path(status: "pending"), class: "px-3 py-1.5 rounded-lg text-sm font-medium #{params[:status] == 'pending' ? 'bg-yellow-500 text-white' : 'bg-white border border-gray-300 text-gray-600 hover:bg-gray-50'}" %>
    <%= link_to "Completado", orders_path(status: "completed"), class: "px-3 py-1.5 rounded-lg text-sm font-medium #{params[:status] == 'completed' ? 'bg-green-600 text-white' : 'bg-white border border-gray-300 text-gray-600 hover:bg-gray-50'}" %>
    <%= link_to "Cancelado", orders_path(status: "cancelled"), class: "px-3 py-1.5 rounded-lg text-sm font-medium #{params[:status] == 'cancelled' ? 'bg-red-600 text-white' : 'bg-white border border-gray-300 text-gray-600 hover:bg-gray-50'}" %>
  </div>

  <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
    <table class="w-full text-sm">
      <thead>
        <tr class="bg-gray-50 border-b border-gray-200">
          <th class="text-left px-4 py-3 font-medium text-gray-600">#</th>
          <th class="text-left px-4 py-3 font-medium text-gray-600">Cliente</th>
          <th class="text-left px-4 py-3 font-medium text-gray-600">Fecha</th>
          <th class="text-right px-4 py-3 font-medium text-gray-600">Total</th>
          <th class="text-center px-4 py-3 font-medium text-gray-600">Estado</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-50">
        <% @orders.each do |order| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3 text-gray-500">#<%= order.id %></td>
            <td class="px-4 py-3 font-medium text-gray-900"><%= order.customer.name %></td>
            <td class="px-4 py-3 text-gray-500"><%= order.created_at.strftime("%d %b %Y") %></td>
            <td class="px-4 py-3 text-right font-medium text-gray-900">$<%= number_with_delimiter(order.total.to_f.round(2)) %></td>
            <td class="px-4 py-3 text-center">
              <span class="px-2 py-0.5 rounded-full text-xs font-medium
                <%= order.completed? ? 'bg-green-100 text-green-700' : order.cancelled? ? 'bg-red-100 text-red-700' : 'bg-yellow-100 text-yellow-700' %>">
                <%= order.status.capitalize %>
              </span>
            </td>
            <td class="px-4 py-3">
              <div class="flex items-center justify-end gap-2">
                <%= link_to order_path(order), class: "p-1.5 text-gray-400 hover:text-indigo-600 rounded" do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
        <% if @orders.empty? %>
          <tr><td colspan="6" class="px-4 py-10 text-center text-gray-400">No hay pedidos. <%= link_to "Crea el primero", new_order_path, class: "text-indigo-600 hover:underline" %>.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
</div>
