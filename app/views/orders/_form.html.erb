<%= form_with model: order, class: "space-y-5" do |f| %>
  <% if order.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4 text-sm text-red-700">
      <ul class="list-disc pl-4 space-y-1">
        <% order.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>

  <%# Cliente %>
  <div>
    <div class="flex items-center justify-between mb-1">
      <%= f.label :customer_id, "Cliente", class: "block text-sm font-medium text-gray-700" %>
      <button type="button" id="toggle-new-customer" class="text-xs text-indigo-600 hover:underline">+ Nuevo cliente</button>
    </div>
    <%= f.collection_select :customer_id, @customers, :id, :name,
      { prompt: "Selecciona un cliente" },
      class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500",
      id: "customer-select" %>

    <%# Formulario rápido de cliente %>
    <div id="new-customer-form" class="hidden mt-3 p-4 bg-indigo-50 border border-indigo-200 rounded-lg space-y-3">
      <p class="text-sm font-medium text-indigo-800">Nuevo cliente</p>
      <div class="grid grid-cols-2 gap-3">
        <input type="text" id="nc-name" placeholder="Nombre *" class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
        <input type="text" id="nc-phone" placeholder="Teléfono" class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
        <input type="email" id="nc-email" placeholder="Email" class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
        <input type="text" id="nc-address" placeholder="Dirección" class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
      </div>
      <div class="flex gap-2">
        <button type="button" id="save-new-customer" class="bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-4 py-2 rounded-lg">Guardar y seleccionar</button>
        <button type="button" id="cancel-new-customer" class="text-sm text-gray-500 hover:text-gray-700 px-3 py-2">Cancelar</button>
      </div>
      <p id="nc-error" class="text-xs text-red-600 hidden"></p>
    </div>
  </div>

  <div>
    <%= f.label :notes, "Notas del pedido", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_area :notes, rows: 2, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500", placeholder: "Instrucciones especiales..." %>
  </div>

  <%# Productos %>
  <div>
    <div class="flex items-center justify-between mb-2">
      <label class="block text-sm font-medium text-gray-700">Productos</label>
    </div>
    <div id="order-items" class="space-y-2">
      <%= f.fields_for :order_items do |item_f| %>
        <%= render "order_item_fields", f: item_f %>
      <% end %>
    </div>
    <button type="button" id="add-item-btn" class="mt-3 inline-flex items-center gap-2 text-sm text-indigo-600 hover:text-indigo-800 font-medium">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      Agregar producto
    </button>
  </div>

  <div class="text-right text-lg font-bold text-gray-800 border-t border-gray-200 pt-3">
    Total: $<span id="total-amount"><%= order.order_items.sum { |i| i.quantity.to_i * i.unit_price.to_f }.round(2) %></span>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= f.submit order.new_record? ? "Crear pedido" : "Guardar cambios", class: "bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-5 py-2 rounded-lg cursor-pointer" %>
    <%= link_to "Cancelar", orders_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  </div>
<% end %>

<template id="item-template">
  <div class="item-row flex items-center gap-2 p-3 bg-gray-50 rounded-lg border border-gray-200">
    <select name="order[order_items_attributes][TIDX][product_id]" class="product-select flex-1 border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
      <option value="">Selecciona producto</option>
      <% @products.each do |p| %>
        <option value="<%= p.id %>" data-price="<%= p.sale_price %>"><%= p.name %> — $<%= p.sale_price %></option>
      <% end %>
    </select>
    <input type="number" name="order[order_items_attributes][TIDX][quantity]" value="1" min="1" class="item-qty w-20 border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
    <input type="hidden" name="order[order_items_attributes][TIDX][unit_price]" class="item-price" value="0">
    <span class="item-subtotal text-sm font-medium text-gray-700 w-24 text-right">$0.00</span>
    <button type="button" class="remove-item text-gray-400 hover:text-red-500 flex-shrink-0">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
  </div>
</template>

<script>
(function() {
  let itemIndex = <%= order.order_items.size + 100 %>;

  function updateTotal() {
    let total = 0;
    document.querySelectorAll('#order-items .item-row').forEach(function(row) {
      if (row.style.display === 'none') return;
      const price = parseFloat(row.querySelector('.item-price').value) || 0;
      const qty = parseInt(row.querySelector('.item-qty').value) || 0;
      const sub = price * qty;
      total += sub;
      row.querySelector('.item-subtotal').textContent = '$' + sub.toFixed(2);
    });
    document.getElementById('total-amount').textContent = total.toFixed(2);
  }

  function bindRow(row) {
    const select = row.querySelector('.product-select');
    const qty = row.querySelector('.item-qty');
    const priceInput = row.querySelector('.item-price');

    if (select) {
      // Si ya tiene producto seleccionado, sincroniza el precio desde la opción
      if (select.value && (!priceInput.value || priceInput.value == '0')) {
        const opt = select.querySelector('option[value="' + select.value + '"]');
        if (opt && opt.dataset.price) priceInput.value = opt.dataset.price;
      }
      select.addEventListener('change', function() {
        const opt = select.selectedOptions[0];
        const price = parseFloat(opt && opt.dataset.price) || 0;
        priceInput.value = price;
        updateTotal();
      });
    }
    if (qty) qty.addEventListener('input', updateTotal);

    const removeBtn = row.querySelector('.remove-item');
    if (removeBtn) {
      removeBtn.addEventListener('click', function() {
        const destroyInput = row.querySelector('input[name*="_destroy"]');
        if (destroyInput) { destroyInput.value = '1'; row.style.display = 'none'; }
        else { row.remove(); }
        updateTotal();
      });
    }
  }

  document.getElementById('add-item-btn').addEventListener('click', function() {
    const tpl = document.getElementById('item-template').innerHTML.replace(/TIDX/g, itemIndex++);
    const div = document.createElement('div');
    div.innerHTML = tpl;
    const row = div.firstElementChild;
    document.getElementById('order-items').appendChild(row);
    bindRow(row);
  });

  document.querySelectorAll('#order-items .item-row').forEach(bindRow);
  updateTotal();

  // Cliente rápido
  const toggleBtn = document.getElementById('toggle-new-customer');
  const cancelBtn = document.getElementById('cancel-new-customer');
  const saveBtn = document.getElementById('save-new-customer');
  const form = document.getElementById('new-customer-form');
  const select = document.getElementById('customer-select');

  if (toggleBtn) toggleBtn.addEventListener('click', function() { form.classList.toggle('hidden'); });
  if (cancelBtn) cancelBtn.addEventListener('click', function() { form.classList.add('hidden'); });

  if (saveBtn) {
    saveBtn.addEventListener('click', function() {
      const name = document.getElementById('nc-name').value.trim();
      const error = document.getElementById('nc-error');
      if (!name) { error.textContent = 'El nombre es requerido.'; error.classList.remove('hidden'); return; }
      error.classList.add('hidden');
      saveBtn.textContent = 'Guardando...';
      saveBtn.disabled = true;

      fetch('/customers.json', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content },
        body: JSON.stringify({ customer: {
          name: name,
          phone: document.getElementById('nc-phone').value,
          email: document.getElementById('nc-email').value,
          address: document.getElementById('nc-address').value
        }})
      })
      .then(function(r) { return r.json().then(function(data) { return { ok: r.ok, data: data }; }); })
      .then(function(res) {
        saveBtn.textContent = 'Guardar y seleccionar';
        saveBtn.disabled = false;
        if (res.ok && res.data.id) {
          const opt = document.createElement('option');
          opt.value = res.data.id;
          opt.textContent = res.data.name;
          opt.selected = true;
          select.appendChild(opt);
          form.classList.add('hidden');
          ['nc-name','nc-phone','nc-email','nc-address'].forEach(function(id) { document.getElementById(id).value = ''; });
        } else {
          const msg = res.data.errors ? res.data.errors.join(', ') : 'Error al guardar el cliente.';
          error.textContent = msg;
          error.classList.remove('hidden');
        }
      })
      .catch(function() {
        saveBtn.textContent = 'Guardar y seleccionar';
        saveBtn.disabled = false;
        error.textContent = 'Error de conexión. Intenta de nuevo.';
        error.classList.remove('hidden');
      });
    });
  }
})();
</script>
