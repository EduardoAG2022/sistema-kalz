<%= form_with model: purchase, class: "space-y-5" do |f| %>
  <% if purchase.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4 text-sm text-red-700">
      <ul class="list-disc pl-4 space-y-1">
        <% purchase.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :product_id, "Producto", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.collection_select :product_id, @products, :id, :name,
      { prompt: "Selecciona un producto" },
      class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :purchased_at, "Fecha de compra", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.date_field :purchased_at, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
    </div>
    <div>
      <%= f.label :supplier, "Proveedor", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :supplier, placeholder: "Nombre del proveedor", class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :quantity, "Unidades compradas", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :quantity, min: 1, id: "purchase-qty", class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
    </div>
    <div>
      <%= f.label :unit_cost, "Costo por unidad ($)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :unit_cost, step: 0.01, min: 0, id: "purchase-cost", class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500", placeholder: "0.00" %>
    </div>
  </div>

  <%# Total calculado %>
  <div class="bg-gray-50 rounded-lg border border-gray-200 px-4 py-3 flex items-center justify-between">
    <span class="text-sm text-gray-600 font-medium">Total de la compra</span>
    <span class="text-lg font-bold text-gray-900">$<span id="purchase-total">0.00</span></span>
  </div>

  <div>
    <%= f.label :notes, "Notas", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_area :notes, rows: 2, placeholder: "Observaciones opcionales...", class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= f.submit purchase.new_record? ? "Registrar compra" : "Guardar cambios", class: "bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-5 py-2 rounded-lg cursor-pointer" %>
    <%= link_to "Cancelar", purchases_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  </div>
<% end %>

<script>
(function() {
  var qty  = document.getElementById('purchase-qty');
  var cost = document.getElementById('purchase-cost');
  var total = document.getElementById('purchase-total');
  function update() {
    var t = (parseFloat(qty && qty.value) || 0) * (parseFloat(cost && cost.value) || 0);
    if (total) total.textContent = t.toFixed(2);
  }
  if (qty)  qty.addEventListener('input', update);
  if (cost) cost.addEventListener('input', update);
  update();
})();
</script>
