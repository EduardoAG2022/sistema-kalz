<%= form_with model: purchase, class: "space-y-6" do |f| %>
  <% if purchase.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4 text-sm text-red-700">
      <ul class="list-disc pl-4 space-y-1">
        <% purchase.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>

  <%# Order name %>
  <div>
    <%= f.label :name, "Nombre de la orden *", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_field :name, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500", placeholder: "Ej. Reposición mayo 2026" %>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <%# Supplier %>
    <div>
      <%= f.label :supplier_id, "Proveedor", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.collection_select :supplier_id, @suppliers, :id, :name,
        { prompt: "Sin proveedor (opcional)" },
        class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
    </div>

    <%# Date %>
    <div>
      <%= f.label :purchased_at, "Fecha de compra *", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.date_field :purchased_at, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
    </div>
  </div>

  <%# Purchase items %>
  <div>
    <div class="flex items-center justify-between mb-2">
      <label class="block text-sm font-medium text-gray-700">Productos</label>
    </div>
    <div id="purchase-items" class="space-y-2">
      <%= f.fields_for :purchase_items do |item_f| %>
        <div class="item-row grid grid-cols-12 gap-2 p-3 bg-gray-50 rounded-lg border border-gray-200 items-center">
          <div class="col-span-4">
            <%= item_f.collection_select :product_id, @products, :id, :name,
              { prompt: "Selecciona producto" },
              class: "product-select w-full border border-gray-300 rounded-lg px-2 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
          </div>
          <div class="col-span-1">
            <%= item_f.label :quantity, "Cant.", class: "block text-xs text-gray-500 mb-0.5" %>
            <%= item_f.number_field :quantity, min: 1, value: item_f.object.quantity || 1, class: "item-qty w-full border border-gray-300 rounded-lg px-2 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
          </div>
          <div class="col-span-2">
            <%= item_f.label :unit_cost, "Costo unit.", class: "block text-xs text-gray-500 mb-0.5" %>
            <%= item_f.number_field :unit_cost, step: 0.01, min: 0, class: "item-cost w-full border border-gray-300 rounded-lg px-2 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500", placeholder: "0.00" %>
          </div>
          <div class="col-span-2">
            <%= item_f.label :sale_price, "P. venta", class: "block text-xs text-gray-500 mb-0.5" %>
            <%= item_f.number_field :sale_price, step: 0.01, min: 0, class: "item-price w-full border border-gray-300 rounded-lg px-2 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500", placeholder: "0.00" %>
          </div>
          <div class="col-span-2 text-right">
            <p class="text-xs text-gray-500 mb-0.5">Subtotal</p>
            <p class="text-sm font-medium text-gray-700 item-subtotal-cost">$0.00</p>
            <p class="text-xs text-gray-400 item-subtotal-revenue">→ $0.00</p>
          </div>
          <div class="col-span-1 flex items-center justify-end pt-4">
            <% if item_f.object.persisted? %>
              <%= item_f.hidden_field :_destroy, class: "destroy-flag", value: "0" %>
            <% end %>
            <button type="button" class="remove-item text-gray-400 hover:text-red-500">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
          </div>
        </div>
      <% end %>
    </div>
    <button type="button" id="add-purchase-item-btn" class="mt-3 inline-flex items-center gap-2 text-sm text-indigo-600 hover:text-indigo-800 font-medium">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      Agregar producto
    </button>
  </div>

  <%# Live summary %>
  <div class="bg-indigo-50 rounded-xl border border-indigo-100 p-4 grid grid-cols-2 sm:grid-cols-4 gap-4">
    <div>
      <p class="text-xs text-indigo-600 font-medium uppercase tracking-wide mb-1">Total unidades</p>
      <p class="text-xl font-bold text-indigo-900" id="summary-units">0</p>
    </div>
    <div>
      <p class="text-xs text-indigo-600 font-medium uppercase tracking-wide mb-1">Total invertido</p>
      <p class="text-xl font-bold text-indigo-900">$<span id="summary-invested">0.00</span></p>
    </div>
    <div>
      <p class="text-xs text-indigo-600 font-medium uppercase tracking-wide mb-1">Total a facturar</p>
      <p class="text-xl font-bold text-indigo-900">$<span id="summary-revenue">0.00</span></p>
    </div>
    <div>
      <p class="text-xs text-indigo-600 font-medium uppercase tracking-wide mb-1">Margen estimado</p>
      <p class="text-xl font-bold text-indigo-900"><span id="summary-margin">0</span>%</p>
    </div>
  </div>

  <%# Notes %>
  <div>
    <%= f.label :notes, "Notas", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= f.text_area :notes, rows: 2, class: "w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500", placeholder: "Observaciones opcionales..." %>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= f.submit purchase.new_record? ? "Crear orden" : "Guardar cambios", class: "bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-5 py-2 rounded-lg cursor-pointer" %>
    <%= link_to "Cancelar", purchases_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  </div>
<% end %>

<template id="purchase-item-template">
  <div class="item-row grid grid-cols-12 gap-2 p-3 bg-gray-50 rounded-lg border border-gray-200 items-center">
    <div class="col-span-4">
      <select name="purchase[purchase_items_attributes][TIDX][product_id]" class="product-select w-full border border-gray-300 rounded-lg px-2 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
        <option value="">Selecciona producto</option>
        <% @products.each do |p| %>
          <option value="<%= p.id %>" data-cost="<%= p.purchase_price %>" data-price="<%= p.sale_price %>"><%= p.name %></option>
        <% end %>
      </select>
    </div>
    <div class="col-span-1">
      <label class="block text-xs text-gray-500 mb-0.5">Cant.</label>
      <input type="number" name="purchase[purchase_items_attributes][TIDX][quantity]" value="1" min="1" class="item-qty w-full border border-gray-300 rounded-lg px-2 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
    </div>
    <div class="col-span-2">
      <label class="block text-xs text-gray-500 mb-0.5">Costo unit.</label>
      <input type="number" name="purchase[purchase_items_attributes][TIDX][unit_cost]" value="" step="0.01" min="0" class="item-cost w-full border border-gray-300 rounded-lg px-2 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" placeholder="0.00">
    </div>
    <div class="col-span-2">
      <label class="block text-xs text-gray-500 mb-0.5">P. venta</label>
      <input type="number" name="purchase[purchase_items_attributes][TIDX][sale_price]" value="" step="0.01" min="0" class="item-price w-full border border-gray-300 rounded-lg px-2 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500" placeholder="0.00">
    </div>
    <div class="col-span-2 text-right">
      <p class="text-xs text-gray-500 mb-0.5">Subtotal</p>
      <p class="text-sm font-medium text-gray-700 item-subtotal-cost">$0.00</p>
      <p class="text-xs text-gray-400 item-subtotal-revenue">→ $0.00</p>
    </div>
    <div class="col-span-1 flex items-center justify-end pt-4">
      <button type="button" class="remove-item text-gray-400 hover:text-red-500">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
  </div>
</template>

<script>
(function() {
  let itemIndex = <%= purchase.purchase_items.size + 100 %>;

  function updateSummary() {
    let units = 0, invested = 0, revenue = 0;
    document.querySelectorAll('#purchase-items .item-row').forEach(function(row) {
      if (row.style.display === 'none') return;
      const destroyFlag = row.querySelector('.destroy-flag');
      if (destroyFlag && destroyFlag.value === '1') return;

      const qty  = parseInt(row.querySelector('.item-qty').value) || 0;
      const cost = parseFloat(row.querySelector('.item-cost').value) || 0;
      const price= parseFloat(row.querySelector('.item-price').value) || 0;
      const subCost = qty * cost;
      const subRev  = qty * price;

      row.querySelector('.item-subtotal-cost').textContent    = '$' + subCost.toFixed(2);
      row.querySelector('.item-subtotal-revenue').textContent = '→ $' + subRev.toFixed(2);

      units    += qty;
      invested += subCost;
      revenue  += subRev;
    });

    document.getElementById('summary-units').textContent    = units;
    document.getElementById('summary-invested').textContent = invested.toFixed(2);
    document.getElementById('summary-revenue').textContent  = revenue.toFixed(2);
    const margin = invested > 0 ? ((revenue - invested) / invested * 100).toFixed(1) : '0.0';
    document.getElementById('summary-margin').textContent   = margin;
  }

  function bindRow(row) {
    const select = row.querySelector('.product-select');
    const costInput  = row.querySelector('.item-cost');
    const priceInput = row.querySelector('.item-price');
    const qtyInput   = row.querySelector('.item-qty');

    if (select) {
      // Auto-fill prices when product is selected
      if (select.value && (!costInput.value || costInput.value === '0' || costInput.value === '')) {
        const opt = select.querySelector('option[value="' + select.value + '"]');
        if (opt) {
          if (opt.dataset.cost) costInput.value  = opt.dataset.cost;
          if (opt.dataset.price) priceInput.value = opt.dataset.price;
        }
      }
      select.addEventListener('change', function() {
        const opt = select.selectedOptions[0];
        if (opt && opt.dataset.cost)  costInput.value  = opt.dataset.cost  || '';
        if (opt && opt.dataset.price) priceInput.value = opt.dataset.price || '';
        updateSummary();
      });
    }
    if (qtyInput)   qtyInput.addEventListener('input', updateSummary);
    if (costInput)  costInput.addEventListener('input', updateSummary);
    if (priceInput) priceInput.addEventListener('input', updateSummary);

    const removeBtn = row.querySelector('.remove-item');
    if (removeBtn) {
      removeBtn.addEventListener('click', function() {
        const destroyFlag = row.querySelector('.destroy-flag');
        if (destroyFlag) {
          destroyFlag.value = '1';
          row.style.display = 'none';
        } else {
          row.remove();
        }
        updateSummary();
      });
    }
  }

  document.getElementById('add-purchase-item-btn').addEventListener('click', function() {
    const tpl = document.getElementById('purchase-item-template').innerHTML.replace(/TIDX/g, itemIndex++);
    const div = document.createElement('div');
    div.innerHTML = tpl;
    const row = div.firstElementChild;
    document.getElementById('purchase-items').appendChild(row);
    bindRow(row);
  });

  document.querySelectorAll('#purchase-items .item-row').forEach(bindRow);
  updateSummary();
})();
</script>
