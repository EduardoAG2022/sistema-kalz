<% content_for :title, @purchase.name %>

<div class="max-w-4xl mx-auto">
  <%# Breadcrumb + header %>
  <div class="mb-6">
    <div class="flex items-center gap-2 text-sm text-gray-500 mb-1">
      <%= link_to "Compras", purchases_path, class: "hover:text-indigo-600" %>
      <span>/</span>
      <span><%= @purchase.name %></span>
    </div>
    <div class="flex items-start justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold text-gray-900"><%= @purchase.name %></h1>
        <div class="flex items-center gap-3 mt-1 text-sm text-gray-500">
          <span><%= @purchase.purchased_at&.strftime("%d de %B, %Y") %></span>
          <% if @purchase.supplier %>
            <span>·</span>
            <%= link_to @purchase.supplier.name, supplier_path(@purchase.supplier), class: "text-indigo-600 hover:underline" %>
          <% end %>
        </div>
      </div>
      <%# Status badge %>
      <% badge_class = case @purchase.status
        when "ordered" then "bg-yellow-50 text-yellow-700 ring-1 ring-yellow-300"
        when "in_transit" then "bg-blue-50 text-blue-700 ring-1 ring-blue-300"
        when "in_stock" then "bg-green-50 text-green-700 ring-1 ring-green-300"
        end %>
      <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium <%= badge_class %>">
        <%= { "ordered" => "Pedido", "in_transit" => "En camino", "in_stock" => "En stock" }[@purchase.status] %>
      </span>
    </div>
  </div>

  <%# Status progress bar %>
  <div class="bg-white rounded-xl border border-gray-200 p-5 mb-5">
    <div class="flex items-center">
      <%# Step 1: Ordered %>
      <div class="flex flex-col items-center flex-1">
        <div class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold <%= @purchase.ordered? || @purchase.in_transit? || @purchase.in_stock? ? 'bg-indigo-600 text-white' : 'bg-gray-200 text-gray-400' %>">
          <% if @purchase.in_transit? || @purchase.in_stock? %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
          <% else %>
            1
          <% end %>
        </div>
        <span class="text-xs mt-1 font-medium <%= @purchase.ordered? ? 'text-indigo-600' : 'text-gray-500' %>">Pedido</span>
      </div>

      <div class="flex-1 h-1 <%= @purchase.in_transit? || @purchase.in_stock? ? 'bg-indigo-600' : 'bg-gray-200' %> mx-2 rounded"></div>

      <%# Step 2: In transit %>
      <div class="flex flex-col items-center flex-1">
        <div class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold <%= @purchase.in_transit? || @purchase.in_stock? ? 'bg-indigo-600 text-white' : 'bg-gray-200 text-gray-400' %>">
          <% if @purchase.in_stock? %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
          <% else %>
            2
          <% end %>
        </div>
        <span class="text-xs mt-1 font-medium <%= @purchase.in_transit? ? 'text-indigo-600' : 'text-gray-500' %>">En camino</span>
      </div>

      <div class="flex-1 h-1 <%= @purchase.in_stock? ? 'bg-indigo-600' : 'bg-gray-200' %> mx-2 rounded"></div>

      <%# Step 3: In stock %>
      <div class="flex flex-col items-center flex-1">
        <div class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold <%= @purchase.in_stock? ? 'bg-green-600 text-white' : 'bg-gray-200 text-gray-400' %>">
          <% if @purchase.in_stock? %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
          <% else %>
            3
          <% end %>
        </div>
        <span class="text-xs mt-1 font-medium <%= @purchase.in_stock? ? 'text-green-700' : 'text-gray-500' %>">En stock</span>
      </div>
    </div>

    <%# Action buttons based on status %>
    <div class="mt-5 pt-4 border-t border-gray-100 flex items-center gap-3 flex-wrap">
      <% if @purchase.ordered? %>
        <%= button_to mark_in_transit_purchase_path(@purchase), method: :patch,
          class: "inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium px-4 py-2 rounded-lg" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8l1.6 8h10.8M10 12h4"/></svg>
          Marcar en camino
        <% end %>
        <%= link_to edit_purchase_path(@purchase), class: "inline-flex items-center gap-2 border border-gray-300 text-gray-700 hover:bg-gray-50 text-sm font-medium px-4 py-2 rounded-lg" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
          Editar
        <% end %>
        <%= button_to purchase_path(@purchase), method: :delete,
          data: { turbo_confirm: "¿Eliminar esta orden de compra? Esta acción no se puede deshacer." },
          class: "inline-flex items-center gap-2 border border-red-300 text-red-600 hover:bg-red-50 text-sm font-medium px-4 py-2 rounded-lg" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
          Eliminar
        <% end %>

      <% elsif @purchase.in_transit? %>
        <%= button_to mark_in_stock_purchase_path(@purchase), method: :patch,
          data: { turbo_confirm: "¿Confirmar recepcion? Se actualizara el stock de #{@purchase.purchase_items.count} producto(s) y los precios de venta seran actualizados." },
          class: "inline-flex items-center gap-2 bg-green-600 hover:bg-green-700 text-white text-sm font-medium px-4 py-2 rounded-lg" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          Confirmar recepcion → En Stock
        <% end %>
        <%= link_to edit_purchase_path(@purchase), class: "inline-flex items-center gap-2 border border-gray-300 text-gray-700 hover:bg-gray-50 text-sm font-medium px-4 py-2 rounded-lg" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
          Editar
        <% end %>

      <% elsif @purchase.in_stock? %>
        <div class="inline-flex items-center gap-2 bg-green-50 text-green-700 text-sm font-medium px-4 py-2 rounded-lg ring-1 ring-green-200">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          Stock actualizado — Orden completada
        </div>
      <% end %>
    </div>
  </div>

  <%# Products table %>
  <div class="bg-white rounded-xl border border-gray-200 overflow-hidden mb-5">
    <div class="px-5 py-3 border-b border-gray-100">
      <h2 class="text-sm font-semibold text-gray-700">Productos (<%= @purchase_items.count %>)</h2>
    </div>
    <% if @purchase_items.empty? %>
      <div class="px-5 py-8 text-center text-gray-400 text-sm">Sin productos registrados en esta orden</div>
    <% else %>
      <table class="w-full text-sm">
        <thead class="bg-gray-50 border-b border-gray-100">
          <tr>
            <th class="text-left px-4 py-3 font-medium text-gray-600">Producto</th>
            <th class="text-right px-4 py-3 font-medium text-gray-600">Cant.</th>
            <th class="text-right px-4 py-3 font-medium text-gray-600">Costo unit.</th>
            <th class="text-right px-4 py-3 font-medium text-gray-600">P. venta</th>
            <th class="text-right px-4 py-3 font-medium text-gray-600">Subtotal costo</th>
            <th class="text-right px-4 py-3 font-medium text-gray-600">Subtotal venta</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50">
          <% @purchase_items.each do |item| %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-3 font-medium text-gray-900">
                <%= link_to item.product.name, product_path(item.product), class: "hover:text-indigo-600" %>
              </td>
              <td class="px-4 py-3 text-right text-gray-700"><%= item.quantity %></td>
              <td class="px-4 py-3 text-right text-gray-700">$<%= number_with_precision(item.unit_cost, precision: 2) %></td>
              <td class="px-4 py-3 text-right text-gray-700">$<%= number_with_precision(item.sale_price, precision: 2) %></td>
              <td class="px-4 py-3 text-right font-medium text-gray-900">$<%= number_with_precision(item.subtotal_cost, precision: 2) %></td>
              <td class="px-4 py-3 text-right font-medium text-green-700">$<%= number_with_precision(item.subtotal_revenue, precision: 2) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>

  <%# Summary cards %>
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-5">
    <div class="bg-white rounded-xl border border-gray-200 p-4 text-center">
      <p class="text-xs text-gray-500 font-medium uppercase tracking-wide mb-1">Total unidades</p>
      <p class="text-2xl font-bold text-gray-900"><%= @purchase.total_units %></p>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 p-4 text-center">
      <p class="text-xs text-gray-500 font-medium uppercase tracking-wide mb-1">Total invertido</p>
      <p class="text-2xl font-bold text-gray-900">$<%= number_with_precision(@purchase.total_invested, precision: 2, delimiter: ',') %></p>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 p-4 text-center">
      <p class="text-xs text-gray-500 font-medium uppercase tracking-wide mb-1">Total a facturar</p>
      <p class="text-2xl font-bold text-green-700">$<%= number_with_precision(@purchase.total_revenue, precision: 2, delimiter: ',') %></p>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 p-4 text-center">
      <p class="text-xs text-gray-500 font-medium uppercase tracking-wide mb-1">Margen</p>
      <p class="text-2xl font-bold <%= @purchase.margin >= 0 ? 'text-green-700' : 'text-red-600' %>"><%= @purchase.margin %>%</p>
    </div>
  </div>

  <% if @purchase.notes.present? %>
    <div class="bg-white rounded-xl border border-gray-200 p-5">
      <p class="text-xs text-gray-500 font-medium uppercase tracking-wide mb-2">Notas</p>
      <p class="text-sm text-gray-700"><%= @purchase.notes %></p>
    </div>
  <% end %>
</div>
