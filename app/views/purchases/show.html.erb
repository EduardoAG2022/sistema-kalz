<% content_for :title, "Compra — Kalz" %>

<div class="max-w-2xl space-y-5">
  <div class="flex items-center gap-3">
    <%= link_to purchases_path, class: "text-gray-400 hover:text-gray-600" do %>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    <% end %>
    <h1 class="text-2xl font-bold text-gray-900">Compra del <%= @purchase.purchased_at.strftime("%d de %B, %Y") %></h1>
  </div>

  <div class="bg-white rounded-xl border border-gray-200 p-6 space-y-4">
    <div class="flex justify-between items-center pb-4 border-b border-gray-100">
      <div>
        <p class="text-xs text-gray-500 mb-1">Producto</p>
        <%= link_to @purchase.product.name, product_path(@purchase.product), class: "font-semibold text-gray-900 hover:text-indigo-600" %>
      </div>
      <div class="text-right">
        <p class="text-xs text-gray-500 mb-1">Proveedor</p>
        <p class="font-medium text-gray-700"><%= @purchase.supplier.presence || "—" %></p>
      </div>
    </div>

    <div class="grid grid-cols-3 gap-4">
      <div class="bg-gray-50 rounded-lg p-4 text-center">
        <p class="text-xs text-gray-500 mb-1">Unidades</p>
        <p class="text-2xl font-bold text-indigo-600"><%= number_with_delimiter(@purchase.quantity) %></p>
      </div>
      <div class="bg-gray-50 rounded-lg p-4 text-center">
        <p class="text-xs text-gray-500 mb-1">Costo unitario</p>
        <p class="text-2xl font-bold text-gray-900">$<%= number_with_delimiter(@purchase.unit_cost) %></p>
      </div>
      <div class="bg-gray-50 rounded-lg p-4 text-center">
        <p class="text-xs text-gray-500 mb-1">Total invertido</p>
        <p class="text-2xl font-bold text-green-600">$<%= number_with_delimiter(@purchase.total_cost.round(2)) %></p>
      </div>
    </div>

    <% if @purchase.notes.present? %>
      <div class="pt-2 border-t border-gray-100">
        <p class="text-xs text-gray-500 mb-1">Notas</p>
        <p class="text-sm text-gray-700"><%= @purchase.notes %></p>
      </div>
    <% end %>
  </div>

  <div class="flex gap-3">
    <%= button_to purchase_path(@purchase), method: :delete,
      data: { turbo_confirm: "¿Eliminar esta compra? El stock del producto se reducirá en #{@purchase.quantity} uds." },
      class: "inline-flex items-center gap-2 border border-red-300 text-red-600 hover:bg-red-50 text-sm font-medium px-4 py-2 rounded-lg" do %>
      Eliminar compra
    <% end %>
  </div>
</div>
