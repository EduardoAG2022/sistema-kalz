<% content_for :title, "Compras" %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">Órdenes de compra</h1>
    <p class="text-sm text-gray-500 mt-0.5">Gestiona tus compras e inventario entrante</p>
  </div>
  <%= link_to new_purchase_path, class: "inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium px-4 py-2 rounded-lg" do %>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
    Nueva orden
  <% end %>
</div>

<%# Summary cards %>
<div class="grid grid-cols-2 gap-4 mb-6">
  <div class="bg-white rounded-xl border border-gray-200 p-4">
    <p class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Total unidades</p>
    <p class="text-2xl font-bold text-gray-900"><%= number_with_delimiter(@total_units) %></p>
  </div>
  <div class="bg-white rounded-xl border border-gray-200 p-4">
    <p class="text-xs font-medium text-gray-500 uppercase tracking-wide mb-1">Total invertido</p>
    <p class="text-2xl font-bold text-gray-900">$<%= number_with_precision(@total_invested, precision: 2, delimiter: ',') %></p>
  </div>
</div>

<%# Status filter tabs %>
<div class="flex items-center gap-1 mb-4 bg-gray-100 p-1 rounded-lg w-fit">
  <%= link_to purchases_path, class: "px-3 py-1.5 rounded-md text-sm font-medium #{params[:status].blank? ? 'bg-white text-gray-900 shadow-sm' : 'text-gray-600 hover:text-gray-900'}" do %>
    Todas
  <% end %>
  <%= link_to purchases_path(status: "ordered"), class: "px-3 py-1.5 rounded-md text-sm font-medium #{params[:status] == 'ordered' ? 'bg-white text-gray-900 shadow-sm' : 'text-gray-600 hover:text-gray-900'}" do %>
    Pedido
  <% end %>
  <%= link_to purchases_path(status: "in_transit"), class: "px-3 py-1.5 rounded-md text-sm font-medium #{params[:status] == 'in_transit' ? 'bg-white text-gray-900 shadow-sm' : 'text-gray-600 hover:text-gray-900'}" do %>
    En camino
  <% end %>
  <%= link_to purchases_path(status: "in_stock"), class: "px-3 py-1.5 rounded-md text-sm font-medium #{params[:status] == 'in_stock' ? 'bg-white text-gray-900 shadow-sm' : 'text-gray-600 hover:text-gray-900'}" do %>
    En stock
  <% end %>
</div>

<% if @purchases.empty? %>
  <div class="text-center py-16 text-gray-400">
    <svg class="w-12 h-12 mx-auto mb-3 opacity-40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
    <p class="text-sm font-medium">No hay órdenes de compra</p>
    <p class="text-xs mt-1"><%= link_to "Crear la primera", new_purchase_path, class: "text-indigo-600 hover:underline" %></p>
  </div>
<% else %>
  <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 border-b border-gray-200">
        <tr>
          <th class="text-left px-4 py-3 font-medium text-gray-600">Orden</th>
          <th class="text-left px-4 py-3 font-medium text-gray-600">Proveedor</th>
          <th class="text-left px-4 py-3 font-medium text-gray-600">Fecha</th>
          <th class="text-left px-4 py-3 font-medium text-gray-600">Estado</th>
          <th class="text-right px-4 py-3 font-medium text-gray-600">Productos</th>
          <th class="text-right px-4 py-3 font-medium text-gray-600">Total invertido</th>
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @purchases.each do |purchase| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-3">
              <%= link_to purchase.name, purchase_path(purchase), class: "font-medium text-indigo-700 hover:underline" %>
            </td>
            <td class="px-4 py-3 text-gray-500">
              <% if purchase.supplier %>
                <%= link_to purchase.supplier.name, supplier_path(purchase.supplier), class: "hover:text-indigo-600" %>
              <% else %>
                <span class="text-gray-400">—</span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-gray-500"><%= purchase.purchased_at&.strftime("%d/%m/%Y") %></td>
            <td class="px-4 py-3">
              <% badge_class = case purchase.status
                when "ordered" then "bg-yellow-50 text-yellow-700 ring-1 ring-yellow-300"
                when "in_transit" then "bg-blue-50 text-blue-700 ring-1 ring-blue-300"
                when "in_stock" then "bg-green-50 text-green-700 ring-1 ring-green-300"
                end %>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium <%= badge_class %>">
                <%= { "ordered" => "Pedido", "in_transit" => "En camino", "in_stock" => "En stock" }[purchase.status] %>
              </span>
            </td>
            <td class="px-4 py-3 text-right text-gray-600"><%= purchase.purchase_items.size %></td>
            <td class="px-4 py-3 text-right font-medium text-gray-900">
              $<%= number_with_precision(purchase.total_invested, precision: 2, delimiter: ',') %>
            </td>
            <td class="px-4 py-3 text-right">
              <%= link_to purchase_path(purchase), class: "text-gray-400 hover:text-indigo-600" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="mt-4">
    <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
  </div>
<% end %>
